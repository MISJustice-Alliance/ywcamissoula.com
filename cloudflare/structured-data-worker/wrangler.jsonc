{
  // Structured-data Worker for www.ywcaofmissoula.com.
  // No routes, account ID, or zone ID are set here on purpose. Bind the
  // production route in the Cloudflare dashboard (see README.md).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ywcaofmissoula-structured-data",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": true }
}
